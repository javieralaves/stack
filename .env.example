# Stack room store (Upstash Redis / Vercel KV)
# Add these on the personal-team Vercel project → Settings → Environment Variables
# Any one pair is enough; preferred names first.

STACK_KV_REST_URL=
STACK_KV_REST_TOKEN=

# Also accepted:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Local-only memory rooms when Redis is unset (automatic in `next dev`):
# STACK_ROOM_MEMORY=1
